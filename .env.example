# Copy to .env and fill in your values
DB_CONNECTION=mongodb://localhost:27017/todo-app
PORT=3005
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# development | production
NODE_ENV=development

# Dev frontend (Next.js default port) — used when NODE_ENV=development
CORS_ORIGIN_DEV=http://localhost:3000

# Production frontend URL(s) — used when NODE_ENV=production
# Comma-separated: https://your-app.vercel.app,https://admin.your-app.com
CORS_ORIGIN=https://your-app.vercel.app

# Rate limiting (optional — 900000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
