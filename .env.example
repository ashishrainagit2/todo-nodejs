# Copy to .env and fill in your values
DB_CONNECTION=mongodb://localhost:27017/todo-app
PORT=3005
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# development | production
NODE_ENV=development

# Dev frontend (Next.js default port) — used when NODE_ENV=development
CORS_ORIGIN_DEV=http://localhost:3000

# Production frontend URL(s) — used when NODE_ENV=production
# Comma-separated: https://your-app.vercel.app,https://admin.your-app.com
CORS_ORIGIN=https://your-app.vercel.app

# Rate limiting (optional — 900000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Logging — fatal | error | warn | info | debug | trace
# Defaults: debug in development, info in production
LOG_LEVEL=debug

# Outbound HTTP: deadline per attempt, then retries with backoff + jitter (learn.md §20, §21)
HTTP_TIMEOUT_MS=3000
HTTP_RETRIES=2
HTTP_BACKOFF_MS=300
HTTP_MAX_BACKOFF_MS=5000

# Circuit breaker per upstream (learn.md §22)
# Trip when >= CB_FAILURE_RATE of the last CB_WINDOW_MS fails, given at least
# CB_MIN_CALLS samples. Then reject everything for CB_OPEN_MS before one scout retries.
CB_WINDOW_MS=10000
CB_FAILURE_RATE=0.5
CB_MIN_CALLS=5
CB_OPEN_MS=30000
